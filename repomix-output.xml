  created_at timestamptz not null default now()
);

create index idx_staff_advances_closure on staff_advances (closure_id);

-- ----------------------------------------------------------------------------
-- EXPENSES (Périmètre des Dépenses)
-- ----------------------------------------------------------------------------
create table expense_categories (
